generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  TEACHER
}

enum Phase {
  PLENUM
  STUDIO
  PAUSE
}

/// Zielgruppe des Workshops — steuert Optik, Ansprache und Metaprompt.
enum AgeGroup {
  GRUNDSCHULE
  MITTELSTUFE
  OBERSTUFE
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  displayName        String
  passwordHash       String
  role               Role
  mustChangePassword Boolean   @default(false)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  workshops          Workshop[]
  auditLogs          AuditLog[]
}

/// Eine KI-Verbindung: Protokoll, Endpunkt, Zugangsschlüssel und Standardmodelle.
/// Der Admin pflegt sie zentral; Lehrkräfte wählen nur noch aus.
model ApiKey {
  id       String @id @default(cuid())
  label    String
  secret   String
  /// "anthropic" (Messages-API) oder "openai" (chat/completions — auch OpenRouter, Langdock, Groq, Ollama …)
  protocol String @default("anthropic")
  /// Leer = Standard-Endpunkt des jeweiligen Protokolls
  baseUrl  String @default("")
  /// Standardmodelle dieser Verbindung
  modelKid      String @default("claude-sonnet-5")
  modelDirector String @default("claude-opus-5")

  /// Preise in Euro pro 1 Mio Tokens — 0 = keine Kostenanzeige
  eurPerMTokensIn  Float @default(0)
  eurPerMTokensOut Float @default(0)
  /// Energie-Schätzfaktor in Wh pro 1 Mio Tokens — 0 = eingebauter Standardwert
  whPerMTokens     Float @default(0)
  /// Gründlichkeit beim Bauen: "" = normal, "hoch" = das Modell denkt länger nach
  /// (mehr Tokens, längere Wartezeit, dafür stimmigere Spiele)
  gruendlich       String @default("")

  createdAt DateTime   @default(now())
  workshops Workshop[]
}

model Workshop {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  className String  @default("")

  teacher   User?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId String?
  apiKey    ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  apiKeyId  String?

  // Ablauf
  totalDays  Int    @default(3)
  currentDay Int    @default(1)
  phase      Phase  @default(PLENUM)

  // Didaktik
  ageGroup     AgeGroup @default(GRUNDSCHULE)
  /// Spielraum der KI (Leitplanken): 1 = weit, die KI ergänzt und entscheidet mit;
  /// 5 = eng, sie tut nur, was gesagt wird. (Name aus der Zeit, als hieran auch die Hilfen hingen.)
  supportLevel Int      @default(2)
  /// Hilfe beim Formulieren auf der Schüler-Seite: 0 keine · 1 Impulse · 2 + Formulierungshilfe
  /// · 3 + Team-Check. Unabhängig vom Spielraum der KI.
  helpLevel    Int      @default(2)
  learningGoal String   @default("") // fachlicher Auftrag der Lehrkraft
  /// Eigene didaktische Zone des Prompts. Leer = die aus Altersstufe,
  /// Unterstützungslevel und Lernziel erzeugte Fassung wird verwendet.
  promptDidactic String @default("")
  presetLabel    String @default("")

  // KI-Konfiguration liegt vollständig bei der Verbindung (ApiKey) — die
  // Lehrkraft wählt nur aus, was der Admin bereitgestellt hat.

  // Limits & Budget (Admin gibt Obergrenzen vor, Lehrkraft nutzt sie)
  genLimitPerLesson Int @default(4)   // Generierungen pro Gruppe pro Schulstunde
  cooldownSeconds   Int @default(120) // Frontend-Pause zwischen Generierungen
  /// Token-Spar-Challenge: Rangliste der sparsamsten Gruppen in der Kinder-UI (Oberstufe)
  challenge         Boolean @default(false)
  tokenBudget       Int @default(2000000) // harte Obergrenze (Input+Output-Tokens)
  tokensUsed        Int @default(0)

  /// Lernfall „Klarer Auftrag, fehlerhaftes Ergebnis" — die Lehrkraft schaltet ihn frei:
  /// 0 aus · 1 erste Fassung · 2 zweite Fassung („alles repariert") · 3 Auflösung
  lernfallStufe Int @default(0)

  // Branding
  colorPrimary String @default("#1d4e89")
  colorAccent  String @default("#c9a24b")
  logoPath     String @default("")
  /// Gestaltung der Beamer-Seite: "" = Markenfarben, "vortrag" = Rot-Weiß für Vorträge vor Erwachsenen
  beamerStil   String @default("")

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  groups    Group[]
}

model Group {
  id         String   @id @default(cuid())
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  workshopId String
  index      Int
  studioName String   @default("")
  code       String   @unique // langer Zufalls-Token, nicht ratbar
  locked     Boolean  @default(false)

  // Generierungs-Kontingent (pro Schulstunde, von Lehrkraft zurücksetzbar)
  genUsed        Int       @default(0)
  genBonus       Int       @default(0)
  lastGenAt      DateTime?
  generating     Boolean   @default(false)
  /// Seit wann läuft die Generierung — daran erkennen wir hängengebliebene Läufe
  /// (Serverneustart mitten im Bau lässt sonst die Gruppe für immer gesperrt).
  generatingSince DateTime?

  /// Eigene Regler dieser Gruppe — leer = es gilt die Einstellung des Workshops.
  /// So lassen sich unterschiedlich starke Gruppen unterschiedlich begleiten.
  supportLevel Int?
  helpLevel    Int?

  /// Director's Cut: Die Lehrkraft legt der Gruppe die verdichtete Spielbeschreibung vor.
  /// dcStatus: "" (nichts offen) · "offen" · "ja" · "nein"
  dcSpec    String @default("")
  dcStatus  String @default("")
  dcHinweis String @default("")

  /// Prüfliste der Gruppe zum Lernfall als JSON (siehe src/lib/lernfall.ts) — leer = noch nichts geprüft
  lernfallBefunde String @default("")

  createdAt DateTime    @default(now())
  prompts   PromptLog[]
  snapshots Snapshot[]

  @@unique([workshopId, index])
}

model PromptLog {
  id        String   @id @default(cuid())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  day       Int
  source    String   @default("child") // child | director-cut
  prompt    String
  ok        Boolean  @default(false)
  error     String   @default("")
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  /// Gemessene Dauer — daraus schätzen wir den Kindern die Wartezeit
  durationMs Int     @default(0)
  createdAt DateTime @default(now())
}

model Snapshot {
  id        String   @id @default(cuid())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  day       Int
  label     String   @default("")
  fileName  String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())
}
